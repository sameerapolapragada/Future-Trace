# Copy to .env.local (gitignored) — use your Supabase dev branch API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only — required for account deletion (auth.admin.deleteUser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deploy origin for Stripe webhook registration (no trailing slash)
APP_URL=https://your-app.vercel.app

# Stripe — checkout + webhook premium activation (see docs/STRIPE_SETUP.md)
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=https://buy.stripe.com/REPLACE_ME

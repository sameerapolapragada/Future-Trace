# Copy to .env.local (gitignored) — use your Supabase dev branch API keys
# Shared with mobile: same URL + anon key as EXPO_PUBLIC_* in mobile/.env
# See docs/SHARED_SUPABASE.md
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-branch-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-branch-anon-key

# Server-only — required for account deletion (auth.admin.deleteUser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deploy origin for Stripe webhook registration (no trailing slash)
APP_URL=https://your-app.vercel.app

# OpenAI — premium roadmap technical execution resources (app/api/analyze-roadmap)
OPENAI_API_KEY=sk_REPLACE_ME
# Optional override (default: gpt-4o-mini)
# OPENAI_ANALYZE_ROADMAP_MODEL=gpt-4o-mini

# Google Gemini — milestone blueprint cache miss generation (app/api/roadmap/activate)
GEMINI_API_KEY=your-gemini-api-key
# Optional override (default: gemini-1.5-flash)
# GEMINI_ROADMAP_MODEL=gemini-1.5-flash
# GEMINI_MATCHER_MODEL=gemini-1.5-flash

# Stripe — checkout + webhook premium activation (see docs/STRIPE_SETUP.md)
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=https://buy.stripe.com/REPLACE_ME

# Same Supabase dev branch as the web app (shared schema, shared users)
# Dashboard → Branches → dev → Settings → API
# See docs/SHARED_SUPABASE.md
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-branch-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-branch-anon-key

# Next.js API (matcher, scan history) — must be reachable from your phone/emulator
# iOS Simulator: http://localhost:3000
# Android Emulator: http://10.0.2.2:3000
# Physical device: http://<your-mac-lan-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: ngrok authtoken (npm run start:tunnel)
# NGROK_AUTHTOKEN=

# Supabase Auth → URL Configuration must include:
# futuretrace://reset-password

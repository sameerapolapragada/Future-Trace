# Same Supabase project / branch as the web app (shared schema)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Next.js API base URL (dev default: http://localhost:3000)
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: your ngrok authtoken (required for npm run start:tunnel)
# https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=

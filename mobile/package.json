  "scripts": {
    "start": "expo start --dev-client --lan",
    "start:dev": "node scripts/start-dev.mjs",
    "start:dev:usb": "node scripts/start-dev-usb.mjs",
    "start:dev:tunnel": "node scripts/start-dev-tunnel.mjs",
    "diagnose:dev": "node scripts/diagnose-dev.mjs",
    "start:expo-go": "node scripts/start-phone.mjs",
    "start:clear": "node scripts/reset-dev-server.mjs && expo start --lan -c",
    "verify:logo": "node scripts/ensure-logo.mjs",
    "start:phone": "node scripts/start-phone.mjs",
    "start:localhost": "node scripts/start-localhost.mjs",
    "start:android": "node scripts/start-android.mjs",
    "start:tunnel": "node scripts/start-tunnel.mjs",
    "start:tunnel:android": "node scripts/start-tunnel.mjs",
    "start:reset": "node scripts/reset-dev-server.mjs",
    "check:connection": "node scripts/check-connection.mjs",
    "android": "expo start --dev-client --android --lan",
    "run:android": "node scripts/ensure-android-local-properties.mjs && expo run:android",
    "build:android:dev": "eas build --profile development --platform android",
    "ios": "expo start --ios --lan",
    "web": "expo start --web"
